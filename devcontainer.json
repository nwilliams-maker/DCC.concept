{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "tactical_workspace_master_rw.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // Heavy apt upgrade runs ONCE on container creation, not every reopen.
  "postCreateCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; echo 'System packages installed'",
  // Security audit M31: install ONLY from the pinned requirements.txt. The
  // previous trailing 'pip3 install --user streamlit' upgraded Streamlit to
  // latest and broke parity with the pinned production version.
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo 'Requirements met'",
  "postAttachCommand": {
    "server": "streamlit run tactical_workspace_master_rw.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
